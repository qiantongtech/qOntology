@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ont: <https://qontology.com/ontology/supply-chain#> .

ont: rdf:type owl:Ontology .
ont: rdfs:label "供应链采购与仓储协同本体" .
ont: owl:versionInfo "v1.0.0" .
ont: dct:identifier "1" .

ont:dataTypeCategory rdf:type owl:AnnotationProperty .

ont:type_1 rdf:type owl:Class .
ont:type_1 rdfs:label "组织" .
ont:type_1 rdfs:comment "具有明确职责和管理结构的业务主体，可承担采购、供应、物流和业务单据管理等活动。" .

ont:type_2 rdf:type owl:Class .
ont:type_2 rdfs:label "供应商" .
ont:type_2 rdfs:comment "向企业提供物料或服务的组织，负责采购订单中约定物料的供应。" .
ont:type_2 rdfs:subClassOf ont:type_1 .

ont:type_3 rdf:type owl:Class .
ont:type_3 rdfs:label "采购方" .
ont:type_3 rdfs:comment "负责采购物料、下达采购订单并接收货物的组织。" .
ont:type_3 rdfs:subClassOf ont:type_1 .

ont:type_4 rdf:type owl:Class .
ont:type_4 rdfs:label "物流服务商" .
ont:type_4 rdfs:comment "提供运输、配送及相关物流服务的组织，承担出库发货的运输任务。" .
ont:type_4 rdfs:subClassOf ont:type_1 .

ont:type_5 rdf:type owl:Class .
ont:type_5 rdfs:label "物料" .
ont:type_5 rdfs:comment "生产经营活动中采购、储存、使用或销售的实物资源。" .

ont:type_6 rdf:type owl:Class .
ont:type_6 rdfs:label "原材料" .
ont:type_6 rdfs:comment "用于生产加工的基础材料，需要维护材料类别、牌号、纯度和质量标准等信息。" .
ont:type_6 rdfs:subClassOf ont:type_5 .

ont:type_7 rdf:type owl:Class .
ont:type_7 rdfs:label "零部件" .
ont:type_7 rdfs:comment "用于组成设备或产品的部件，需要维护规格型号、图号和质量要求等信息。" .
ont:type_7 rdfs:subClassOf ont:type_5 .

ont:type_8 rdf:type owl:Class .
ont:type_8 rdfs:label "成品" .
ont:type_8 rdfs:comment "完成生产加工并可交付使用的产品，可以通过组成关系追溯其零部件。" .
ont:type_8 rdfs:subClassOf ont:type_5 .

ont:type_9 rdf:type owl:Class .
ont:type_9 rdfs:label "采购订单" .
ont:type_9 rdfs:comment "记录采购物料、供应商、采购金额和交货约定的业务单据。" .

ont:type_10 rdf:type owl:Class .
ont:type_10 rdfs:label "入库单" .
ont:type_10 rdfs:comment "记录物料接收、验收及入库情况的业务单据，用于到货核对和仓储追溯。" .

ont:type_11 rdf:type owl:Class .
ont:type_11 rdfs:label "出库单" .
ont:type_11 rdfs:comment "记录物料出库和发货信息的业务单据，用于追溯物料流向、承运主体及收货方。" .

